; =====================================================================
; LuminIRIS - container build-time setup script
; Invoked by the Dockerfile via:
;   iris session IRIS -U USER < /irisdev/app/setup.script
;
; NOTE: this file runs line-by-line in DIRECT MODE (never compiled), so
; no $$$ macros and no { } blocks - single statements only.
; =====================================================================

; Load and run the bundled bootstrap installer (replaces the old ZPM step
; - see GitHub issue #4). It copies the static portal files, configures
; /csp/user, compiles Luminiris.PythonApi in %SYS, creates the JWT-secured
; /luminiris/api REST application, and disables password expiration.
zn "USER"
set sc=$system.OBJ.Load("/irisdev/app/src/install/Luminiris.Installer.cls","ck")
write "[luminiris] Installer loaded: ",$system.Status.GetErrorText(sc),!
if $system.Status.IsError(sc) halt

set sc=##class(Luminiris.Installer).Install("/irisdev/app/src/csp")
write "[luminiris] Install: ",$system.Status.GetErrorText(sc),!

halt
